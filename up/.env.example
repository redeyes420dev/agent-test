# Пример файла переменных окружения для агента разработки
# Скопируйте этот файл в .env и заполните своими значениями

# ======================
# API КЛЮЧИ ПРОВАЙДЕРОВ
# ======================

# OpenAI API ключ (для GPT-4.1-mini)
# Получить на: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API ключ (для Claude)
# Получить на: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# GitHub Personal Access Token
# Получить на: https://github.com/settings/tokens
# Нужны права: repo, read:user, read:org
GITHUB_TOKEN=ghp_your-github-token-here

# Bright Data API Token (для веб-скрапинга)
# Получить на: https://brightdata.com/cp/zones
BRIGHTDATA_TOKEN=your-brightdata-token-here

# Google API ключ (опционально)
GOOGLE_API_KEY=your-google-api-key-here

# Azure OpenAI (опционально)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-api-key-here

# ======================
# БЕЗОПАСНОСТЬ
# ======================

# Ключ шифрования для API ключей (сгенерируйте новый!)
# Можно сгенерировать командой: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here

# JWT секретный ключ для аутентификации
JWT_SECRET=your-super-secret-jwt-key-here

# Алгоритм JWT
JWT_ALGORITHM=HS256

# Время жизни токена доступа (в минутах)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ======================
# БАЗА ДАННЫХ
# ======================

# URL базы данных PostgreSQL
DATABASE_URL=postgresql://agent_user:agent_pass@localhost:5432/coding_agent

# Для SQLite (для разработки)
# DATABASE_URL=sqlite:///./coding_agent.db

# Redis URL для кэширования
REDIS_URL=redis://localhost:6379/0

# ======================
# GIT НАСТРОЙКИ
# ======================

# Рабочая директория для Git репозиториев
GIT_WORKSPACE=./repos

# Максимальный размер репозитория
MAX_REPO_SIZE=500MB

# Разрешенные домены для Git операций
ALLOWED_DOMAINS=github.com,gitlab.com,bitbucket.org

# Таймаут Git операций (в секундах)
GIT_TIMEOUT=300

# ======================
# НАСТРОЙКИ АГЕНТОВ
# ======================

# Максимальное количество итераций агента
MAX_ITERATIONS=10

# Режим отладки
DEBUG_MODE=false

# Размер контекстного окна
CONTEXT_WINDOW_SIZE=1000000

# Модель по умолчанию
DEFAULT_MODEL=gpt-4.1-mini-2025-04-14

# ======================
# ВЕБ-СЕРВЕР
# ======================

# Хост для запуска сервера
HOST=0.0.0.0

# Порт для запуска сервера
PORT=8000

# Режим разработки
RELOAD=true

# CORS origins (разделенные запятыми)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ======================
# МОНИТОРИНГ И ЛОГИРОВАНИЕ
# ======================

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Включить метрики Prometheus
ENABLE_METRICS=true

# Директория для логов
LOG_DIR=./logs

# Максимальный размер лог файла
MAX_LOG_SIZE=100MB

# Количество ротаций логов
LOG_BACKUP_COUNT=5

# ======================
# DOCKER И SANDBOX
# ======================

# Режим песочницы для выполнения кода
SANDBOX_MODE=secure

# Максимальное время выполнения кода (в секундах)
MAX_EXECUTION_TIME=30

# Максимальное использование памяти
MAX_MEMORY=512M

# Максимальное использование CPU
MAX_CPU=1.0

# ======================
# MCP СЕРВЕРЫ
# ======================

# Порты для MCP серверов
MCP_SANDBOX_PORT=8001
MCP_TESTING_PORT=8002
MCP_DOCS_PORT=8003
MCP_GITHUB_PORT=8004
MCP_BRIGHTDATA_PORT=8005

# Таймауты для MCP серверов (в секундах)
MCP_CONNECT_TIMEOUT=10
MCP_REQUEST_TIMEOUT=30

# ======================
# ПРОИЗВОДИТЕЛЬНОСТЬ
# ======================

# Количество воркеров для uvicorn
WORKERS=1

# Размер пула соединений к БД
DB_POOL_SIZE=10

# Максимальное количество переполненных соединений
DB_MAX_OVERFLOW=20

# Таймаут соединения с БД (в секундах)
DB_POOL_TIMEOUT=30

# ======================
# ОГРАНИЧЕНИЯ И КВОТЫ
# ======================

# Максимальное количество запросов в минуту на пользователя
RATE_LIMIT_PER_MINUTE=60

# Максимальное количество API ключей на пользователя
MAX_API_KEYS_PER_USER=10

# Максимальный месячный лимит по умолчанию (в долларах)
DEFAULT_MONTHLY_LIMIT=100

# Максимальное количество активных сессий
MAX_ACTIVE_SESSIONS=100

# ======================
# ИНТЕГРАЦИИ
# ======================

# Webhook URL для уведомлений
WEBHOOK_URL=https://your-webhook-url.com/notifications

# Email настройки для уведомлений
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# Slack интеграция (опционально)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ======================
# РАЗРАБОТКА
# ======================

# Включить автоматическую перезагрузку
AUTO_RELOAD=true

# Показывать детальные ошибки
SHOW_ERROR_DETAILS=true

# Включить SQL логирование
SQL_ECHO=false

# Директория для тестов
TEST_DIR=./tests

# Покрытие тестами (минимальный процент)
MIN_COVERAGE=80